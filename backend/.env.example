# =====================================================================
# DealPilot AI — Environment Configuration Example
# =====================================================================

# Environment (development | production)
ENVIRONMENT=development

# Database URL
# Default uses local SQLite file storage (zero configuration needed!)
# For PostgreSQL: postgresql://user:password@localhost:5432/dealpilot
DATABASE_URL=sqlite:///./dealpilot.db

# ---------------------------------------------------------------------
# Telephony Provider (Twilio) - Optional for Real Calls
# Leave empty to run in 100% Free Simulated Demo Mode
# ---------------------------------------------------------------------
TELEPHONY_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Public HTTPS URL reachable by Twilio for webhooks (e.g. ngrok or server URL)
WEBHOOK_BASE_URL=

# ---------------------------------------------------------------------
# AI Keys (Optional) - DealPilot has built-in rule-based NLP fallback
# ---------------------------------------------------------------------
OPENAI_API_KEY=
GEMINI_API_KEY=
